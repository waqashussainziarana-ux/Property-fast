# Do not commit real secrets. Set these through Vercel project environment variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Email address authorised by your SMTP provider, not the visitor's address.
SMTP_FROM=
# Long random secret for short-lived enquiry-form tokens.
FORM_SECRET=
# Final https origin without a trailing slash, required for custom-domain form submissions.
SITE_URL=
# Leave false until the site is approved for launch.
PUBLISH_INDEXABLE=false
